<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="13142" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="12042"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
    </dependencies>
    <scenes>
        <!--A neutral kebab background, nothing else: the runtime blob is the
            one loading treatment, so the system launch frame must read as
            the app opening directly into it. Two layers, both static:
            systemBackground underneath always resolves the right appearance
            (verified: the snapshot renderer honors dynamic system colors),
            and the full-bleed image on top carries kebab's exact background
            hexes (light F4F3F0 / dark 111112) as explicit light/dark
            variants with a transparent Any fallback — so environments that
            resolve catalog traits get a pixel-exact handoff into the
            runtime blob frame, and ones that don't (observed: the iOS 26.5
            simulator snapshot ignores catalog variants) fall back to the
            correct-appearance system color, never to a wrong-appearance
            frame.-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" image="LaunchBackgroundFill" translatesAutoresizingMaskIntoConstraints="NO" id="bg1-fx-img">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="bg1-fx-img" firstAttribute="top" secondItem="Ze5-6b-2t3" secondAttribute="top" id="bgc-t0-p01"/>
                            <constraint firstItem="bg1-fx-img" firstAttribute="bottom" secondItem="Ze5-6b-2t3" secondAttribute="bottom" id="bgc-b0-p02"/>
                            <constraint firstItem="bg1-fx-img" firstAttribute="leading" secondItem="Ze5-6b-2t3" secondAttribute="leading" id="bgc-l0-p03"/>
                            <constraint firstItem="bg1-fx-img" firstAttribute="trailing" secondItem="Ze5-6b-2t3" secondAttribute="trailing" id="bgc-r0-p04"/>
                        </constraints>
                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchBackgroundFill" width="8" height="8"/>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>
